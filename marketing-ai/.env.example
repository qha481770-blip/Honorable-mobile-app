# Server
HOST=127.0.0.1
PORT=4173
PUBLIC_BASE_URL=http://127.0.0.1:4173
DATA_DIR=./data

# Official platform APIs only. Adapters remain NOT CONFIGURED when absent.
TIKTOK_ACCESS_TOKEN=
INSTAGRAM_ACCESS_TOKEN=
YOUTUBE_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
GOOGLE_TRENDS_PROVIDER_KEY=

# Optional provider adapters. No paid AI or email provider is required locally.
MARKETING_LLM_PROVIDER=local-rules
EMAIL_PROVIDER=disabled
EMAIL_API_KEY=
EMAIL_FROM=
